# Copy to .env and fill in real values. Safe to commit.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1

# Comma-separated deployment names for the model picker.
# The FIRST one is the default selection. Add more by appending.
AZURE_OPENAI_DEPLOYMENTS=gpt-5.4-nano
